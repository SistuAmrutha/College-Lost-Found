# Backend Environment Configuration Example
# Copy to .env or set system environment variables

SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/college_lost_found
# For MongoDB Atlas use:
# SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/college_lost_found?retryWrites=true&w=majority

JWT_SECRET=CollegeLostAndFoundApp2026SuperSecretKeyMustBeAtLeast32BytesLong
JWT_EXPIRATION_MS=86400000
FRONTEND_ORIGIN=http://localhost:5173
SEED_ENABLED=true
UPLOAD_DIR=uploads

# Optional Cloudinary Credentials (leave empty for local storage fallback)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
